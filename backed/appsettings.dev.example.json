{
  "DataPath": "data",
  "Cors": {
    "Origins": [
      "http://localhost:3782",
      "http://localhost:3000"
    ]
  },
  "ConnectionStrings": {
    "Default": "server=YOUR_SQL_SERVER;uid=YOUR_USER;pwd=YOUR_PASSWORD;database=AGENT;TrustServerCertificate=true"
  },
  "Database": {
    "CodeFirst": true
  },
  "Upload": {
    "MaxRequestBodySizeBytes": 209715200
  },
  "CodeRepository": {
    "AllowedRoots": [
      "E:\\Projects"
    ]
  },
  "Codex": {
    "Command": "codex",
    "RuntimeLeaseSeconds": 90,
    "MaxSessionsPerUser": 3
  },
  "Dsh": {
    "Enabled": false,
    "Command": "dsh-jsonrpc-agent",
    "ConfigPath": "E:\\项目\\know-why\\deepseek-harness\\examples\\jsonrpc-agent\\aiagent.cordis.yml",
    "SessionRoot": "E:\\AiAgent\\data\\dsh-sessions",
    "Provider": "deepseek-official",
    "Model": "deepseek-chat",
    "ApiKey": "",
    "BaseUrl": "https://api.deepseek.com",
    "PermissionMode": "workspace-write",
    "AllowDangerFullAccess": false,
    "RuntimeLeaseSeconds": 90,
    "MaxSessionsPerUser": 2
  },
  "ChatAttachments": {
    "RootPath": "",
    "MaxImageBytes": 10485760,
    "MaxImagesPerTurn": 4,
    "RetentionMinutes": 60
  },
  "Usage": {
    "AdminUsernames": ""
  },
  "Rag": {
    "PythonPath": "Rag/.venv/Scripts/python.exe",
    "LlamaIndexWorkerPath": "Rag/llamaindex_worker.py"
  },
  "PythonWorkers": {
    "BasePath": "PythonWorkers",
    "TimeoutSeconds": 900,
    "Ocr": {
      "PythonPath": "PythonWorkers/ocr/.venv/Scripts/python.exe",
      "WorkerPath": "PythonWorkers/ocr/paddle_ocr_worker.py"
    }
  },
  "ImageOcr": {
    "CachePath": "data/image_ocr_cache"
  }
}
