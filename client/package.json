{
  "name": "aiagent-terminal-client",
  "version": "0.1.0",
  "private": true,
  "description": "AiAgent local workspace and human terminal desktop client",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "dev": "npm run start",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@xterm/xterm": "^5.5.0",
    "electron": "^37.2.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ssh2": "^1.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/ssh2": "^1.15.5",
    "esbuild": "^0.25.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vitest": "^3.1.2"
  }
}
